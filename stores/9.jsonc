{
  "storeId": 9,
  // The shop is a server rendered Next.js storefront on Medusa, without
  // structured data, a sitemap or robots.txt. / redirects to /is.
  "startUrl": "https://vefverslun.ok.is/is/store",
  "type": "httpcrawler",
  "productPageIdentifier": "data-testid=\"product-container\"",
  // /is/store and /is/categories/<category> list 12 products a page, their
  // page buttons are JavaScript so only ?page=N reaches the other pages.
  // A page past the last one shows the last page again.
  "urlWhitelist": ["/is/products", "/is/categories", "/is/store"],
  // 87 pages (1036 products) on 2026-11-06, with room to grow
  "startUrls": [
    "https://vefverslun.ok.is/is/store?page=2",
    "https://vefverslun.ok.is/is/store?page=3",
