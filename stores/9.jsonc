  ],
  "selectors": {
    // The whole page, so the image can be read from <head> and the breadcrumb
    // and the attribute table, which are outside the product container
    "productPage": "html:has([data-testid=\"product-container\"])",
    "name": "[data-testid=\"product-title\"]",
    // e.g. "C6BN9AV#56281486"
    "sku": "[data-testid=\"product-sku\"]",
    // "71.108 kr", with VAT. No product was on sale to check the old price,
    // this is the line-through price of the Medusa storefront template.
    "oldPrice": "[data-testid=\"original-product-price\"]",
    "listPrice": "[data-testid=\"product-price\"]",
    // The gallery images are /_next/image urls
    "image": "meta[property=\"og:image\"]",
    "imageAttribute": "content",
    // The "Vörulýsing" section, the short description is in
    // [data-testid="product-description"]
    "description": "h2 + div.leading-relaxed",
    // Vörur / <categories> / <product>
    "categories": ".content-container.pt-6 ul",
    "categoryItemLocator": "li a",
    // Products in stock have an add to cart button, the others read
    // "Uppselt" and "Hafa Samband"
    "inStock": "[data-testid=\"product-container\"]",
    "inStockText": "Setja í körfu",
    // The "Eiginleikar" table
    "attributes": {
      "attributesTable": "table",
      "attribute": "tr",
      "attributeLabel": "td:nth-child(1)",
      "attributeValue": "td:nth-child(2)"
    }
  }
}
